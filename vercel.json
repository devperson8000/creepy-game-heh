{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/testhalloween",
      "destination": "https://monochrome-halloween-tests.vercel.app/testhalloween",
      "permanent": false
    },
    {
      "source": "/testhalloween/",
      "destination": "https://monochrome-halloween-tests.vercel.app/testhalloween",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/backrooms",
      "destination": "/index.html"
    },
    {
      "source": "/backrooms/",
      "destination": "/index.html"
    },
    {
      "source": "/monochrome2",
      "destination": "/index.html"
    },
    {
      "source": "/monochrome2/",
      "destination": "/index.html"
    },
    {
      "source": "/monochrome2/play/",
      "destination": "/index.html"
    },
    {
      "source": "/monochrome2/play",
      "destination": "/index.html"
    },
    {
      "source": "/secretroom",
      "destination": "/index.html"
    },
    {
      "source": "/secretroom/",
      "destination": "/index.html"
    },
    {
      "source": "/sunnychen",
      "destination": "/index.html"
    },
    {
      "source": "/sunnychen/",
      "destination": "/index.html"
    }
  ]
}
